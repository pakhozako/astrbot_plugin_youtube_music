{
  "dependency_update_timeout_seconds": {"description": "依赖更新总超时", "type": "int", "default": 1800, "slider": {"min": 60, "max": 7200, "step": 60}, "hint": "包含等待、下载、校验和安装；超时后回滚，回滚完成前不会释放维护锁。"},
  "queue_admin_user_ids": {"description": "QQ 队列管理员 ID", "type": "string", "default": "", "hint": "QQ 用户 ID，逗号、分号或空格分隔。AstrBot 管理员也可控制队列；普通成员只能取消或移除自己的歌曲。"},
  "allowed_group_ids": {"description": "允许点歌的 QQ 群", "type": "string", "default": "", "hint": "群 ID，逗号、分号或空格分隔。留空允许所有群；私聊不受此项限制。"},
  "send_strategy": {"description": "发送策略", "type": "string", "default": "voice_then_link", "options": ["voice_only", "voice_then_link", "link_only"], "hint": "语音失败时可提交视频链接；超时结果未知，不自动回退。链接不计入语音历史。"},
  "youtube_proxy": {"description": "YouTube 代理", "type": "string", "default": "", "secret": true, "hint": "http、https 或 socks5 代理地址。留空使用系统代理；内容不会返回 WebUI。"},
  "dependency_proxy": {"description": "依赖下载代理", "type": "string", "default": "", "secret": true, "hint": "http 或 https 代理地址。留空使用默认连接；内容不会返回 WebUI。"},
  "search_results": {"description": "候选歌曲数", "type": "int", "default": 5, "slider": {"min": 3, "max": 10, "step": 1}},
  "result_ttl_minutes": {"description": "候选有效期（分钟）", "type": "int", "default": 15, "slider": {"min": 1, "max": 120, "step": 1}},
  "max_duration_seconds": {"description": "音频时长上限（秒）", "type": "int", "default": 180, "slider": {"min": 15, "max": 900, "step": 15}},
  "max_download_size_mb": {"description": "源媒体大小上限（MiB）", "type": "int", "default": 50, "slider": {"min": 5, "max": 500, "step": 5}},
  "max_wav_size_mb": {"description": "WAV 大小上限（MiB）", "type": "int", "default": 8, "slider": {"min": 1, "max": 100, "step": 1}, "hint": "16 kHz 单声道 PCM 约每秒 32 KB，同时受时长限制。"},
  "search_timeout_seconds": {"description": "搜索超时（秒）", "type": "int", "default": 45, "slider": {"min": 10, "max": 180, "step": 5}},
  "metadata_timeout_seconds": {"description": "元数据超时（秒）", "type": "int", "default": 45, "slider": {"min": 10, "max": 180, "step": 5}},
  "download_timeout_seconds": {"description": "下载超时（秒）", "type": "int", "default": 240, "slider": {"min": 30, "max": 1800, "step": 30}},
  "conversion_timeout_seconds": {"description": "转换超时（秒）", "type": "int", "default": 90, "slider": {"min": 10, "max": 600, "step": 10}},
  "send_timeout_seconds": {"description": "消息提交超时（秒）", "type": "int", "default": 60, "slider": {"min": 5, "max": 300, "step": 5}},
  "max_concurrent_jobs": {"description": "全局任务并发", "type": "int", "default": 2, "slider": {"min": 1, "max": 5, "step": 1}},
  "send_concurrency": {"description": "消息发送并发", "type": "int", "default": 2, "slider": {"min": 1, "max": 5, "step": 1}},
  "max_queued_jobs": {"description": "等待处理任务上限", "type": "int", "default": 5, "slider": {"min": 0, "max": 50, "step": 1}, "hint": "这是全局处理准入限制，不是每会话的歌曲队列长度。"},
  "max_session_queue": {"description": "每会话歌曲队列上限", "type": "int", "default": 20, "slider": {"min": 1, "max": 50, "step": 1}},
  "queue_wait_timeout_seconds": {"description": "资源等待超时（秒）", "type": "int", "default": 120, "slider": {"min": 5, "max": 900, "step": 5}, "hint": "聊天、AI、WebUI 和依赖维护使用同一超时。"},
  "request_cooldown_seconds": {"description": "搜索冷却（秒）", "type": "int", "default": 3, "slider": {"min": 0, "max": 60, "step": 1}},
  "search_result_auto_recall": {"description": "自动撤回机器人搜索结果", "type": "bool", "default": true, "hint": "仅撤回本插件直接发送且核实身份与内容的 QQ 搜索结果。成功按编号入队或收藏后提前撤回；不撤回用户、AI 回复及其他业务消息。"},
  "search_result_recall_delay_seconds": {"description": "搜索结果撤回延迟（秒）", "type": "int", "default": 60, "slider": {"min": 5, "max": 120, "step": 5}, "hint": "从搜索结果发送返回后开始计时。协议端拒绝或校验失败时停止该次撤回，不自动重试。候选有效期不随消息撤回改变。"},
  "audio_cache_retention_hours": {"description": "音频缓存保留（小时）", "type": "int", "default": 24, "slider": {"min": 1, "max": 720, "step": 1}},
  "audio_cache_max_mb": {"description": "音频缓存容量（MiB）", "type": "int", "default": 512, "slider": {"min": 32, "max": 8192, "step": 32}},
  "max_history_items": {"description": "个人会话历史上限", "type": "int", "default": 100, "slider": {"min": 10, "max": 500, "step": 10}},
  "max_favorites_per_user": {"description": "个人会话收藏上限", "type": "int", "default": 100, "slider": {"min": 10, "max": 500, "step": 10}}
}
