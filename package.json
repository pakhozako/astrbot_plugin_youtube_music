{
  "name": "astrbot-youtube-music-console",
  "version": "0.2.0",
  "description": "Material 3 console for the AstrBot YouTube Music plugin",
  "author": "pakhozako",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pakhozako/astrbot_plugin_youtube_music.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild frontend/console.js --bundle --minify --format=esm --target=es2022 --loader:.svg=text --outfile=views/console/app.js --legal-comments=linked",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "preview": "python -B tests/preview_server.py"
  },
  "devDependencies": {
    "@material-symbols/svg-400": "0.49.0",
    "@playwright/test": "1.65.1",
    "esbuild": "0.28.2",
    "material": "3.14.1"
  }
}
